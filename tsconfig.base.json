{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@apexafrica/database": ["./libs/database/src/index.ts"],
      "web": ["./shared/web/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
