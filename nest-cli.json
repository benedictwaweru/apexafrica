{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/apexafrica/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/apexafrica/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/apexafrica",
  "projects": {
    "apexafrica": {
      "type": "application",
      "root": "apps/apexafrica",
      "entryFile": "main",
      "sourceRoot": "apps/apexafrica/src",
      "compilerOptions": {
        "tsConfigPath": "apps/apexafrica/tsconfig.app.json"
      }
    },
    "logging": {
      "type": "library",
      "root": "libs/logging",
      "entryFile": "index",
      "sourceRoot": "libs/logging/src",
      "compilerOptions": {
        "tsConfigPath": "libs/logging/tsconfig.lib.json"
      }
    },
    "logistics": {
      "type": "application",
      "root": "apps/logistics",
      "entryFile": "main",
      "sourceRoot": "apps/logistics/src",
      "compilerOptions": {
        "tsConfigPath": "apps/logistics/tsconfig.app.json"
      }
    }
  }
}
