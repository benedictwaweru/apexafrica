{
  "name": "web-logistics",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "web/logistics/src",
  "projectType": "application",
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/{options.outDir}", "{projectRoot}/dist"],
      "defaultConfiguration": "development",
      "options": {
        "config": "./vite.config.ts",
        "outDir": "../../dist/web/logistics"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["web/logistics/**/*.{ts,tsx}"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "configFile": "web/logistics/vite.config.ts"
      }
    },
    "docker:build": {
      "executor": "@nx-tools/nx-container:build",
      "options": {
        "file": "web/logistics/Dockerfile",
        "context": "{workspaceRoot}",
        "target": "dev",
        "tags": ["apexafrica/logistics-webclient:latest"]
      },
      "configurations": {
        "production": {
          "target": "prod",
          "tags": ["apexafrica.azurecr.io/logistics-webclient:latest"],
          "push": true
        }
      }
    }
  }
}
